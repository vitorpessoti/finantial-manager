generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model transactions {
  id          String   @id @default(uuid())
  userId      String
  type        String
  description String
  value       Float
  category    String
  date        DateTime
  createdAt   DateTime @default(now())
}
